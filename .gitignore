# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.open-next/

# Cloudflare / Wrangler local state (never deploy as Pages config)
.wrangler/
.wrangler-dry-run*/
wrangler-dry-run.log

# Never commit root Wrangler auto-detect configs (Pages misreads them as Workers)
/wrangler.json
/wrangler.jsonc
/wrangler.toml

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.cursor/
qa-screenshots/
