{
  "name": "gglbet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-games-indexes.cjs && next build --webpack && node scripts/flatten-static-export.cjs",
    "build:turbo": "node scripts/generate-games-indexes.cjs && next build --turbopack && node scripts/flatten-static-export.cjs",
    "start": "npx --yes serve out -p 3000",
    "serve:static": "npx --yes serve out -p 3000",
    "lint": "eslint",
    "preview": "npm run serve:static",
    "cf-build:legacy": "node scripts/generate-games-indexes.cjs && opennextjs-cloudflare build && opennextjs-cloudflare populateCache local",
    "deploy:legacy-opennext": "npm run cf-build:legacy && opennextjs-cloudflare deploy --config config/legacy/wrangler.open-next.legacy.jsonc",
    "cf-typegen": "wrangler types --config config/legacy/wrangler.open-next.legacy.jsonc --env-interface CloudflareEnv cloudflare-env.d.ts",
    "generate:games-indexes": "node scripts/generate-games-indexes.cjs",
    "generate:promotion-artwork": "node scripts/install-promotion-kv.cjs",
    "generate:guide-artwork": "node scripts/install-guide-editorial-kv.cjs",
    "generate:news-artwork": "node scripts/install-news-editorial-kv.cjs",
    "audit:promotion-artwork": "node scripts/audit-promotion-kv-uniqueness.cjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.49.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.120.0"
  }
}
